#!/bin/sh

set -eu

remote_url=${2:-}

github_repository_path() {
  github_url=$1

  case "$github_url" in
    git@github.com:*|github.com:*) github_path=${github_url#*:} ;;
    *://github.com/*) github_path=${github_url#*://github.com/} ;;
    *://*@github.com/*) github_path=${github_url#*@github.com/} ;;
    *://github.com:*/*)
      github_path=${github_url#*://github.com:}
      github_path=${github_path#*/}
      ;;
    *://*@github.com:*/*)
      github_path=${github_url#*@github.com:}
      github_path=${github_path#*/}
      ;;
    *) return 1 ;;
  esac

  github_path=${github_path%%\#*}
  github_path=${github_path%%\?*}
  github_path=${github_path%/}
  github_path=${github_path%.git}
  printf '%s\n' "$github_path"
}

is_github_remote() {
  github_repository_path "$1" >/dev/null
}

# Stream YunBox's report line by line: its terminal prompt must come after the
# report. Only a below-budget report is dropped, keeping such pushes quiet.
forward_report() {
  awk 'NR == 1 && $0 == "推送检查：未超限" { quiet = 1 } !quiet { print; fflush() }'
}

supports_confirmation() {
  "$yunbox_path" inspect --help </dev/null 2>/dev/null | grep -q -- '--confirm'
}

is_github_remote "$remote_url" || exit 0

# A composed repository hook owns the check and then invokes git-lfs. Named
# hooks alone are not fail-fast: Git can still run later hooks after failure.
if [ "${WORKSTATION_YUNBOX_CHAIN:-}" != 1 ]; then
  repository_hook=$(git rev-parse --git-path hooks/pre-push 2>/dev/null || true)
  if [ -x "$repository_hook" ] && sed -n '2p' "$repository_hook" | grep -qx '# yunbox-pre-push-v1'; then
    exit 0
  fi
fi

yunbox_path=${WORKSTATION_YUNBOX_BIN:-}
if [ -z "$yunbox_path" ]; then
  yunbox_path=$(command -v yunbox 2>/dev/null || true)
fi
if [ -z "$yunbox_path" ] || [ ! -x "$yunbox_path" ]; then
  printf '已阻止推送：找不到 YunBox CLI。请安装支持 yunbox inspect --confirm 的版本（0.1.3+），或设置 WORKSTATION_YUNBOX_BIN 为可执行文件绝对路径。\n' >&2
  exit 1
fi

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/git-large-push.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM

# YunBox owns the over-budget confirmation: its dialog, terminal fallback and exit code.
set -- inspect --push --stdin --remote "$remote_url" --confirm
# Preserve the existing Workstation Git-pack budget when explicitly configured.
configured=$(git config --type=int --get workstation.largePushGuardBytes 2>/dev/null || true)
case "$configured" in
  ''|*[!0-9]*) ;;
  *) set -- "$@" --git-limit "$configured" ;;
esac

{
  status=0
  "$yunbox_path" "$@" || status=$?
  printf '%s\n' "$status" >"$tmp_dir/status"
} | forward_report >&2
status=$(cat "$tmp_dir/status" 2>/dev/null || true)
case "$status" in
  0) exit 0 ;;
  # Over budget and not confirmed (cancelled, or nobody to ask), or a freeze window: YunBox has said why.
  1) exit 1 ;;
esac

if ! supports_confirmation; then
  version=$("$yunbox_path" --version </dev/null 2>/dev/null || true)
  printf '已阻止推送：YunBox CLI %s不支持 inspect --confirm。请升级到 0.1.3 或更新版本。\n' "${version:+$version }" >&2
  exit 1
fi
printf '已阻止推送：YunBox 检查失败（退出码 %s）。\n' "${status:-未知}" >&2
exit 1
