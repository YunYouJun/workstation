#!/bin/sh

set -eu

remote_name=${1:-unknown}
remote_url=${2:-}

github_repository_path() {
  github_url=$1

  case "$github_url" in
    git@github.com:*|github.com:*) github_path=${github_url#*:} ;;
    *://github.com/*) github_path=${github_url#*://github.com/} ;;
    *://*@github.com/*) github_path=${github_url#*@github.com/} ;;
    *://github.com:*/*)
      github_path=${github_url#*://github.com:}
      github_path=${github_path#*/}
      ;;
    *://*@github.com:*/*)
      github_path=${github_url#*@github.com:}
      github_path=${github_path#*/}
      ;;
    *) return 1 ;;
  esac

  github_path=${github_path%%\#*}
  github_path=${github_path%%\?*}
  github_path=${github_path%/}
  github_path=${github_path%.git}
  printf '%s\n' "$github_path"
}

is_github_remote() {
  github_repository_path "$1" >/dev/null
}

format_repository_label() {
  repository_url=$1
  fallback_name=$2

  if repository_path=$(github_repository_path "$repository_url"); then
    printf 'github.com/%s\n' "$repository_path"
  else
    printf '%s\n' "$fallback_name"
  fi
}

confirm_push() {
  report=$1
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  repo_name=${repo_root##*/}
  repository_label=$(format_repository_label "$remote_url" "$repo_name")
  remote_label=$remote_name
  if [ "$remote_name" = "$remote_url" ]; then
    remote_label='直接地址'
  fi

  printf '\n%s\n' "$report" >&2

  if osascript_path=$(command -v osascript 2>/dev/null); then
    if "$osascript_path" - "$repository_label" "$remote_label" "$report" <<'APPLESCRIPT' >/dev/null
on run argv
  set repositoryLabel to item 1 of argv
  set remoteLabel to item 2 of argv
  set reportText to item 3 of argv
  set messageText to "仓库：" & repositoryLabel & return & "远程：" & remoteLabel & "（github.com）" & return & return & reportText
  display dialog messageText with title "确认 GitHub 大流量推送" buttons {"取消", "继续推送"} default button "取消" cancel button "取消" with icon caution
end run
APPLESCRIPT
    then
      return 0
    fi

    printf '已取消 GitHub 大流量推送。\n' >&2
    return 1
  fi

  if [ -t 2 ] && [ -r /dev/tty ] && [ -w /dev/tty ]; then
    printf '\nGitHub 大流量推送：%s/%s。是否继续？[y/N] ' "$repository_label" "$remote_label" >/dev/tty
    answer=''
    IFS= read -r answer </dev/tty || true
    case "$answer" in
      y|Y|yes|YES) return 0 ;;
    esac
  else
    printf '无法请求确认：osascript 与交互式终端均不可用。\n' >&2
  fi

  printf '已阻止 GitHub 大流量推送。\n' >&2
  return 1
}

is_github_remote "$remote_url" || exit 0

# A composed repository hook owns the check and then invokes git-lfs. Named
# hooks alone are not fail-fast: Git can still run later hooks after failure.
if [ "${WORKSTATION_YUNBOX_CHAIN:-}" != 1 ]; then
  repository_hook=$(git rev-parse --git-path hooks/pre-push 2>/dev/null || true)
  if [ -x "$repository_hook" ] && sed -n '2p' "$repository_hook" | grep -qx '# yunbox-pre-push-v1'; then
    exit 0
  fi
fi

yunbox_path=${WORKSTATION_YUNBOX_BIN:-}
if [ -z "$yunbox_path" ]; then
  yunbox_path=$(command -v yunbox 2>/dev/null || true)
fi
if [ -z "$yunbox_path" ] || [ ! -x "$yunbox_path" ]; then
  printf '已阻止推送：找不到 YunBox CLI。请安装支持 yunbox inspect 的版本，或设置 WORKSTATION_YUNBOX_BIN 为可执行文件绝对路径。\n' >&2
  exit 1
fi

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/git-large-push.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM

set -- inspect --push --stdin --remote "$remote_url"
# Preserve the existing Workstation Git-pack budget when explicitly configured.
configured=$(git config --type=int --get workstation.largePushGuardBytes 2>/dev/null || true)
case "$configured" in
  ''|*[!0-9]*) ;;
  *) set -- "$@" --git-limit "$configured" ;;
esac

status=0
"$yunbox_path" "$@" >"$tmp_dir/report" 2>"$tmp_dir/error" || status=$?
case "$status" in
  0) exit 0 ;;
  1)
    if [ ! -s "$tmp_dir/report" ]; then
      printf '已阻止推送：YunBox 没有返回超限报告。请检查 CLI 版本。\n' >&2
      exit 1
    fi
    confirm_push "$(cat "$tmp_dir/report")"
    ;;
  *)
    printf '已阻止推送：YunBox 检查失败（退出码 %s）。\n' "$status" >&2
    cat "$tmp_dir/error" >&2
    exit 1
    ;;
esac
