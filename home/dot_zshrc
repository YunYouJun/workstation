# More info: https://workstation.yunyoujun.cn/guide/terminal
# Oh My Zsh plugins are loaded directly to keep startup fast while preserving
# the familiar aliases and interactive behavior.
# --------

typeset -U path PATH fpath FPATH

_path_prepend() {
  [[ -d "$1" ]] && path=("$1" "${path[@]}")
}

_path_append() {
  [[ -d "$1" ]] && path+=("$1")
}

_is_interactive_tty() {
  [[ -o interactive && -t 0 && -t 1 ]]
}

# Codex Desktop currently exposes TERM=dumb to some interactive shells, which
# makes prompts like Starship disable themselves. Keep this scoped to Codex.
if [[ -o interactive && "${TERM:-}" == "dumb" && ( "${CODEX_SHELL:-}" == "1" || "${__CFBundleIdentifier:-}" == "com.openai.codex" ) ]]; then
  export TERM="xterm-256color"
fi

# Homebrew environment without spawning `brew shellenv` and `path_helper` for
# every terminal. Keep the common Apple Silicon and Intel layouts explicit.
if [[ -d /opt/homebrew ]]; then
  export HOMEBREW_PREFIX="/opt/homebrew"
  export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
  export HOMEBREW_REPOSITORY="/opt/homebrew"
elif [[ -d /usr/local/Homebrew ]]; then
  export HOMEBREW_PREFIX="/usr/local"
  export HOMEBREW_CELLAR="/usr/local/Cellar"
  export HOMEBREW_REPOSITORY="/usr/local/Homebrew"
fi

if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
  _path_prepend "$HOMEBREW_PREFIX/sbin"
  _path_prepend "$HOMEBREW_PREFIX/bin"
  [[ -d "$HOMEBREW_PREFIX/share/zsh/site-functions" ]] \
    && fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" "${fpath[@]}")
fi

# ---- Lean Zsh plugins and completion ----

export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
export ZSH_CUSTOM="${ZSH_CUSTOM:-$ZSH/custom}"
export ZSH_CACHE_DIR="${ZSH_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/workstation/zsh}"

HIST_STAMPS="yyyy-mm-dd"
COMPLETION_WAITING_DOTS="true"

omz_plugins=(git node dotenv)
[[ "$OSTYPE" == darwin* ]] && omz_plugins+=(macos)
omz_plugins+=(docker docker-compose)

if [[ -d "$ZSH" ]]; then
  fpath=("$ZSH/functions" "$ZSH/completions" "${fpath[@]}")
  for plugin in "${omz_plugins[@]}"; do
    [[ -d "$ZSH/plugins/$plugin" ]] && fpath=("$ZSH/plugins/$plugin" "${fpath[@]}")
  done
fi

if [[ -o interactive ]]; then
  [[ -d "$ZSH_CACHE_DIR/completions" ]] || mkdir -p "$ZSH_CACHE_DIR/completions"
  fpath=("$ZSH_CACHE_DIR/completions" "${fpath[@]}")
  completion_dump="$ZSH_CACHE_DIR/zcompdump-$ZSH_VERSION"
  completion_audit="$ZSH_CACHE_DIR/last-compaudit"

  autoload -Uz add-zsh-hook compinit is-at-least
  zstyle ':completion:*' use-cache yes
  zstyle ':completion:*' cache-path "$ZSH_CACHE_DIR"

  # Run the security audit and refresh discovery once per day. Warm shells use
  # the compiled dump directly instead of scanning hundreds of completion files.
  if [[ ! -s "$completion_dump" || ! -e "$completion_audit" || -n "$completion_audit"(#qN.mh+24) ]]; then
    compinit -i -d "$completion_dump"
    : >| "$completion_audit"
  else
    compinit -C -d "$completion_dump"
  fi

  if [[ -s "$completion_dump" && ( ! -s "$completion_dump.zwc" || "$completion_dump" -nt "$completion_dump.zwc" ) ]]; then
    zcompile "$completion_dump"
  fi

  # Source only the small Oh My Zsh pieces that provide existing shell behavior.
  for library in functions history key-bindings completion; do
    [[ -r "$ZSH/lib/$library.zsh" ]] && source "$ZSH/lib/$library.zsh"
  done

  for plugin in "${omz_plugins[@]}"; do
    [[ -r "$ZSH/plugins/$plugin/$plugin.plugin.zsh" ]] \
      && source "$ZSH/plugins/$plugin/$plugin.plugin.zsh"
  done
fi
unset library plugin omz_plugins completion_dump completion_audit

# Preserve the `omz` maintenance command without paying its CLI load cost at
# shell startup.
omz() {
  unfunction omz
  if [[ ! -r "$ZSH/lib/cli.zsh" ]]; then
    echo "Oh My Zsh CLI is unavailable: $ZSH/lib/cli.zsh" >&2
    return 1
  fi
  source "$ZSH/lib/cli.zsh"
  omz "$@"
}

# Interactive editing plugins prefer Homebrew and fall back to existing custom
# Oh My Zsh checkouts.
autosuggestions_plugin="${HOMEBREW_PREFIX:-}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
if [[ -o interactive && -r "$autosuggestions_plugin" ]]; then
  source "$autosuggestions_plugin"
elif [[ -o interactive && -r "$ZSH_CUSTOM/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$ZSH_CUSTOM/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi
unset autosuggestions_plugin

# ---- User configuration ----

export VISUAL="${VISUAL:-buddycn}"
export EDITOR="${EDITOR:-$VISUAL}"

# fnm (fast node manager)
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd --shell zsh)"
fi

# pnpm
export PNPM_HOME="${PNPM_HOME:-$HOME/Library/pnpm}"
_path_prepend "$PNPM_HOME"

# bun
export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
[[ -s "$BUN_INSTALL/_bun" ]] && source "$BUN_INSTALL/_bun"
_path_prepend "$BUN_INSTALL/bin"

# ruby
if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
  _path_prepend "$HOMEBREW_PREFIX/opt/ruby/bin"
fi

# android
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Library/Android/sdk}"
_path_append "$ANDROID_HOME/platform-tools"

if [[ -n "${HOMEBREW_PREFIX:-}" && -d "$HOMEBREW_PREFIX/opt/openjdk@21" ]]; then
  export JAVA_HOME="${JAVA_HOME:-$HOMEBREW_PREFIX/opt/openjdk@21}"
fi

if [[ -d "$ANDROID_HOME/ndk" ]]; then
  ndk_versions=("$ANDROID_HOME"/ndk/*(N/))
  if (( ${#ndk_versions[@]} > 0 )); then
    export NDK_HOME="${NDK_HOME:-${ndk_versions[-1]}}"
  fi
  unset ndk_versions
fi

# envman
[[ -s "$HOME/.config/envman/load.sh" ]] && source "$HOME/.config/envman/load.sh"

# Additional PATH
_path_prepend "$HOME/.codebuddy/bin"            # CodeBuddy CN
_path_prepend "$HOME/.local/bin"                # CloudBase CLI
_path_prepend "$HOME/background_agent_cli/bin"  # background_agent_cli

# simple-git-hooks: ensure pnpm is in PATH for GUI git clients
export SIMPLE_GIT_HOOKS_RC="$HOME/.simple-git-hooks-rc"

# fzf
if _is_interactive_tty && command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

# zoxide
if [[ -o interactive ]] && command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# prompt
if [[ -o interactive && "${TERM:-}" != "dumb" ]] && command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
else
  # Powerlevel10k remains a fallback when Starship is unavailable.
  p10k_theme="$ZSH_CUSTOM/themes/powerlevel10k/powerlevel10k.zsh-theme"
  [[ -r "$p10k_theme" ]] \
    || p10k_theme="${HOMEBREW_PREFIX:-/opt/homebrew}/share/powerlevel10k/powerlevel10k.zsh-theme"
  if [[ -o interactive && "${TERM:-}" != "dumb" && -r "$p10k_theme" ]]; then
    source "$p10k_theme"
    [[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
  elif [[ -o interactive ]]; then
    PROMPT='%F{cyan}%~%f %# '
  fi
  unset p10k_theme
fi

starship-theme() {
  local action="${1:-status}"
  local config="${STARSHIP_CONFIG:-$HOME/.config/starship.toml}"
  local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/workstation/starship"
  local saved_current="$state_dir/current.toml"
  local backup_dir="$state_dir/backups"
  local repo_default="${WORKSTATION_STARSHIP_DEFAULT:-}"

  if [[ -z "$repo_default" ]]; then
    if command -v ghq >/dev/null 2>&1; then
      local repo_root
      repo_root="$(ghq list -p github.com/YunYouJun/workstation 2>/dev/null | head -n 1)"
      [[ -n "$repo_root" ]] && repo_default="$repo_root/home/dot_config/starship.toml"
    fi
    repo_default="${repo_default:-$HOME/repos/github.com/YunYouJun/workstation/home/dot_config/starship.toml}"
  fi

  case "$action" in
    default)
      [[ -r "$repo_default" ]] || { echo "Missing workstation Starship default: $repo_default" >&2; return 1; }
      mkdir -p "$(dirname "$config")" "$state_dir" "$backup_dir" || return
      [[ -r "$config" ]] && cp "$config" "$saved_current"
      [[ -r "$config" ]] && cp "$config" "$backup_dir/starship.$(date +%Y%m%d%H%M%S).toml"
      cp "$repo_default" "$config"
      echo "Starship theme: default -> $config"
      ;;
    current|restore)
      [[ -r "$saved_current" ]] || { echo "No saved Starship current theme: $saved_current" >&2; return 1; }
      mkdir -p "$(dirname "$config")" "$backup_dir" || return
      [[ -r "$config" ]] && cp "$config" "$backup_dir/starship.$(date +%Y%m%d%H%M%S).toml"
      cp "$saved_current" "$config"
      echo "Starship theme: current -> $config"
      ;;
    save|save-current)
      [[ -r "$config" ]] || { echo "Missing Starship config: $config" >&2; return 1; }
      mkdir -p "$state_dir" || return
      cp "$config" "$saved_current"
      echo "Starship current theme saved: $saved_current"
      ;;
    preset)
      local preset_name="$2"
      [[ -n "$preset_name" ]] || { echo "Usage: starship-theme preset <name>" >&2; return 1; }
      command -v starship >/dev/null 2>&1 || { echo "starship is not installed" >&2; return 1; }
      mkdir -p "$(dirname "$config")" "$state_dir" "$backup_dir" || return
      [[ -r "$config" ]] && cp "$config" "$saved_current"
      [[ -r "$config" ]] && cp "$config" "$backup_dir/starship.$(date +%Y%m%d%H%M%S).toml"
      starship preset "$preset_name" -o "$config" --force
      ;;
    list)
      command -v starship >/dev/null 2>&1 && starship preset --list
      ;;
    status)
      echo "config: $config"
      echo "default: $repo_default"
      echo "current: $saved_current"
      if [[ -r "$config" && -r "$repo_default" ]] && cmp -s "$config" "$repo_default"; then
        echo "active: default"
      elif [[ -r "$config" && -r "$saved_current" ]] && cmp -s "$config" "$saved_current"; then
        echo "active: current"
      elif [[ -r "$config" ]]; then
        echo "active: custom"
      else
        echo "active: missing"
      fi
      ;;
    *)
      echo "Usage: starship-theme {status|default|current|save-current|preset <name>|list}" >&2
      return 1
      ;;
  esac
}
alias stheme="starship-theme"

# ---- Aliases ----

# dev shortcuts (using ni toolchain)
alias build="nr build"
alias dev="nr dev"
alias lint="nr lint"
alias lintf="pnpm run lint --fix" # npm can not pass --fix
alias mock="nr mock"
alias serve="nr serve"
alias tc="nr typecheck"

# git
alias gcgithub="git config user.name 'YunYouJun' && git config user.email 'me@yunyoujun.cn'"
# git fetch & 工蜂
(( $+aliases[gf] )) && unalias gf

# tencent npm mirror
alias tnpm="pnpm i --registry=http://mirrors.tencent.com/npm/"

# Terminal proxy.
# Override TERMINAL_PROXY_HOST / TERMINAL_PROXY_HTTP_PORT /
# TERMINAL_PROXY_SOCKS_PORT in a machine-local shell file when needed.
goproxy() {
  local host="${TERMINAL_PROXY_HOST:-127.0.0.1}"
  local http_port="${TERMINAL_PROXY_HTTP_PORT:-8234}"
  local socks_port="${TERMINAL_PROXY_SOCKS_PORT:-8235}"

  export https_proxy="http://${host}:${http_port}"
  export http_proxy="http://${host}:${http_port}"
  export all_proxy="socks5://${host}:${socks_port}"
  export HTTPS_PROXY="$https_proxy"
  export HTTP_PROXY="$http_proxy"
  export ALL_PROXY="$all_proxy"
}

disproxy() {
  unset https_proxy http_proxy all_proxy HTTPS_PROXY HTTP_PROXY ALL_PROXY
}

# python
alias python2="$HOME/.pyenv/versions/2.7.18/bin/python2"

syntax_highlighting_plugin="${HOMEBREW_PREFIX:-}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
if [[ -o interactive && -r "$syntax_highlighting_plugin" ]]; then
  source "$syntax_highlighting_plugin"
elif [[ -o interactive && -r "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
unset syntax_highlighting_plugin

unfunction _path_prepend _path_append _is_interactive_tty
